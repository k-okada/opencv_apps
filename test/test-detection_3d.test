<launch>
  <arg name="gui" default="true" />

  <!-- the RGB-D images of test/rgbd_walking.mp4 and test/rgbd_walking_depth.npz (TUM RGB-D) in a loop, on image,
       depth and camera_info -->
  <node name="publish_rgbd" pkg="opencv_apps" type="publish_rgbd.py" />

  <!-- the people by dnn_object_detection_nodelet.cpp, which downloads the models at the first time -->
  <include file="$(find opencv_apps)/launch/dnn_object_detection.launch" >
    <arg name="debug_view" value="$(arg gui)" />
    <arg name="image" value="image" />
  </include>

  <!-- detection_3d_nodelet.cpp -->
  <include file="$(find opencv_apps)/launch/detection_3d.launch" >
    <arg name="input" value="dnn_object_detection/detections" />
    <arg name="depth" value="depth" />
    <arg name="camera_info" value="camera_info" />
  </include>

  <param name="detection_3d_detections_test/topic" value="detection_3d/detections" />
  <test test-name="detection_3d_detections_test" pkg="rostest" type="hztest" name="detection_3d_detections_test" time-limit="300" >
    <param name="hz" value="9.0" />
    <param name="hzerror" value="8.9" />
    <param name="test_duration" value="2.0" />
    <param name="wait_time" value="240.0" />
  </test>
</launch>
